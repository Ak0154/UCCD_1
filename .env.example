# =============================================================================
# UCCD — Environment Variables Template
# Copy this file to .env and fill in your values.
# =============================================================================

# --- Database (PostgreSQL — Neon cloud or local Docker) ---
# Neon cloud: copy your connection string from the Neon dashboard
# POSTGRES_URL=postgresql://neondb_owner:npg_xxxx@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Local Docker: use the compose-provided credentials (see docker-compose.yml)
POSTGRES_URL=postgresql://neondb_owner:npg_YOUR_KEY@ep-YOUR_HOST.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
POSTGRES_PASSWORD=npg_YOUR_KEY
# Set to 'require' for Neon/production, 'disable' only for local Docker PostgreSQL
POSTGRES_SSLMODE=require

# --- Redis ---
REDIS_URL=redis://:uccd_redis_pass@localhost:6379/0
REDIS_PASSWORD=uccd_redis_pass

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9093

# --- JWT Authentication ---
SECRET_KEY=change-me-to-a-random-64-char-hex-string
JWT_ALG=HS256
JWT_EXPIRES_MINUTES=720

# --- Groq AI (LLM) ---
GROQ_API_KEY=gsk_your_groq_api_key_here

# --- Telegram Bot (optional) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
API_HOST=http://localhost:8000

# --- Demo Accounts (used by auth.py hardcoded login) ---
# WARNING: Change these passwords before deploying anywhere outside localhost
DEMO_SUPERVISOR_EMAIL=supervisor@example.com
DEMO_SUPERVISOR_PASSWORD=change-me
DEMO_AGENT_EMAIL=agent@example.com
DEMO_AGENT_PASSWORD=change-me
DEMO_COMPLIANCE_EMAIL=compliance@example.com
DEMO_COMPLIANCE_PASSWORD=change-me

# --- Sarvam AI Translation ---
SARVAM_ACCESS_TOKEN=your_sarvam_api_key_here